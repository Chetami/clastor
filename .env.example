# Clastor - Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ============================================================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================================================

# JWT Secret - MUST be changed in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Firebase Configuration (Service Account)
# Download the service account JSON file from Firebase Console > Project Settings > Service Accounts
# Place it in the backend directory and reference it here
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Email (SMTP via nodemailer) — used for "Notify Student" lesson reminders.
# For Gmail, use an App Password (not your account password) and SMTP_SECURE=true with port 465,
# or SMTP_SECURE=false with port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Technical sender. The address MUST be the SMTP_USER (or an address the
# account can send as) for SPF/DMARC. The name becomes the "via <name>"
# suffix on each email; the tutor's name is shown as the From display name
# and their email is set as Reply-To.
EMAIL_FROM="Examify TMS <your-email@gmail.com>"

# Minimum time between "Notify Student" sends for the same lesson, in milliseconds.
# Default is 24 hours (86400000). Prevents accidental spamming / double-sends.
NOTIFY_COOLDOWN_MS=86400000

# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================================================

# API Configuration
VITE_API_URL=http://localhost:3001

# Firebase Configuration (Client SDK)
# Get these from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Create a Firebase project at https://console.firebase.google.com/
# 2. Enable Authentication (Email/Password provider)
# 3. Create a Firestore database
# 4. Download service account JSON (Settings > Service Accounts > Generate Private Key)
#    - Save as `firebase-service-account.json` in the backend directory
#    - Set FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json
# 5. Get your web app configuration (Settings > General > Your apps)
# 6. Create your first admin user in Firebase Console Authentication
# 7. Create a matching user document in Firestore 'users' collection:
#    {
#      name: "Admin User",
#      email: "admin@example.com",
#      role: "system_admin",
#      createdAt: Firestore Timestamp,
#      updatedAt: Firestore Timestamp
#    }
