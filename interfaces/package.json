{
  "name": "@examify-tms/interfaces",
  "version": "1.0.0",
  "description": "Shared TypeScript interfaces for Clastor",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:types && npm run build:reexports && npm run build:flags && npm run build:flags:esm",
    "build:types": "openapi-typescript src/openapi.yaml -o dist/index.d.ts",
    "build:reexports": "node scripts/add-reexports.js",
    "build:swift-auth": "node scripts/generate-swift-auth.cjs",
    "check:swift-auth": "node scripts/generate-swift-auth.cjs --check",
    "build:swift-students": "node scripts/generate-swift-auth.cjs --students",
    "check:swift-students": "node scripts/generate-swift-auth.cjs --students --check",
    "build:swift-home": "node scripts/generate-swift-auth.cjs --home",
    "check:swift-home": "node scripts/generate-swift-auth.cjs --home --check",
    "build:swift-lessons": "node scripts/generate-swift-auth.cjs --lessons",
    "check:swift-lessons": "node scripts/generate-swift-auth.cjs --lessons --check",
    "build:swift-payments": "node scripts/generate-swift-auth.cjs --payments",
    "check:swift-payments": "node scripts/generate-swift-auth.cjs --payments --check",
    "build:flags": "tsc -p tsconfig.json",
    "build:flags:esm": "tsc -p tsconfig.esm.json",
    "postinstall": "npm run build",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "js-yaml": "^4.3.2",
    "openapi-typescript": "^7.4.0"
  },
  "license": "AGPL-3.0"
}
