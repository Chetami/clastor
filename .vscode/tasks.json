{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Backend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev:backend"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+)\\s+-\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Backend server running",
          "endsPattern": "(Type|check)\\s+error"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Dev: Frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev:frontend"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+)\\s+-\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Local:",
          "endsPattern": "error"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Dev: All",
      "dependsOn": ["Dev: Backend", "Dev: Frontend"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build: All",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:all"],
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Build: Interfaces",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:interfaces"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build: Backend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:backend"],
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Build: Frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:frontend"],
      "group": "build",
      "problemMatcher": ["$tsc", "$eslint-stable"]
    },
    {
      "label": "Install",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "problemMatcher": []
    }
  ]
}
