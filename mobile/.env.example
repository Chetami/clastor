# ── Backend ───────────────────────────────────────────────────────────────
# Absolute base URL of the API. Use the SAME value as the web app's VITE_API_URL.
#
# On a physical device `localhost` is the PHONE, not your dev machine.
# Point this at your machine's LAN IP instead, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:3001
# and make sure the backend is listening on that interface (0.0.0.0).
EXPO_PUBLIC_API_URL=http://localhost:3001

# ── Firebase ──────────────────────────────────────────────────────────────
# Use the SAME Firebase project as the web app (copy from frontend/.env).
# Email/password sign-in MUST be enabled in the Firebase console
# (Authentication → Sign-in method → Email/Password).
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── Google Sign-In ─────────────────────────────────────────────────────────
# OAuth client IDs from Google Cloud Console (APIs & Services → Credentials).
# `webClientId` is the one Firebase shows under Authentication → Sign-in
# method → Google → "Web SDK configuration" — Firebase uses it to verify the
# ID token returned by the native SDK. `iosClientId` is the iOS OAuth client
# (its bundle ID must be com.xamify.chetami.clastor-mobile); it also drives
# the iOS URL scheme registered by the google-signin config plugin
# (see app.config.js). `androidClientId` is the Android OAuth client.
# `webClientId` and `iosClientId` are required; Android needs google-services.json too.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
