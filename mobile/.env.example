# ── Google Sign-In (optional) ────────────────────────────────────────────────
# Create an iOS OAuth Client ID:
#   Google Cloud Console → APIs & Services → Credentials → Create Credentials
#   → OAuth Client ID → iOS → Bundle ID: com.examifytms.app
#
# The Client ID looks like: 448534189562-xxxxx.apps.googleusercontent.com
# The REVERSED form (for app.json URL scheme): com.googleusercontent.apps.448534189562-xxxxx
#
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
