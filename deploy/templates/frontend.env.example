# Frontend environment for a deployed build.
# Created from deploy/templates/frontend.env.example by deploy/new-environment.ps1.
# VITE_API_URL is derived from the backend URL. The VITE_FIREBASE_* values are the
# PUBLIC web-app config from Firebase Console (Project Settings > Your apps) — they
# are NOT secret, but are filled in per environment because each env is its own
# Firebase project.

# Derived by the bootstrap from the backend URL.
VITE_API_URL=REPLACE_WITH_BACKEND_URL

VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID

# Public token + host from PostHog (Project Settings). Not secret.
VITE_POSTHOG_PROJECT_TOKEN=REPLACE_WITH_POSTHOG_PROJECT_TOKEN
VITE_POSTHOG_HOST=REPLACE_WITH_POSTHOG_HOST
