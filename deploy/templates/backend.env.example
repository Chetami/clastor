# Backend environment for a deployed environment.
# Created from deploy/templates/backend.env.example by deploy/new-environment.ps1.
# Lines marked REPLACE_WITH_ must be filled in (or copied from another env via
# -From <env>) before deploying. deploy_backend.ps1 refuses to ship placeholders.

# JWT signing secret — generate a long random string per environment.
JWT_SECRET=REPLACE_WITH_JWT_SECRET

# Firebase Admin service-account JSON. Resolved by the deploy script to the file
# shipped next to the app root — keep this relative path.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# Server
PORT=3001
# Derived by the bootstrap from the frontend URL.
CORS_ORIGIN=REPLACE_WITH_FRONTEND_URL
# Derived from the backend URL (OAuth callback target).
GOOGLE_OAUTH_REDIRECT_URI=REPLACE_WITH_BACKEND_URL/api/auth/google/callback
# Derived from the frontend URL (post-OAuth redirect).
FRONTEND_URL=REPLACE_WITH_FRONTEND_URL
# Derived from the backend URL (RSVP links in lesson emails).
PUBLIC_API_URL=REPLACE_WITH_BACKEND_URL

# Email (SMTP via nodemailer) — lesson "Notify Student" reminders.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASS
# Technical sender. The address MUST be SMTP_USER (or an address the account can
# send as) for SPF/DMARC. Name becomes the "via <name>" suffix.
EMAIL_FROM=REPLACE_WITH_EMAIL_FROM

# Min time between "Notify Student" sends for the same lesson (ms). Default 24h.
NOTIFY_COOLDOWN_MS=86400000

# Google Calendar / Meet — per-tutor OAuth client.
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET

# Stripe Connect — tutors accept card payments settled to their own account.
# Use TEST keys (sk_test_/whsec_) for dev/staging; LIVE keys for prod.
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
