# JWT Secret - MUST be changed in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Firebase Configuration
# Path to service account JSON file (relative or absolute path)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Email (SMTP via nodemailer) — used for "Notify Student" lesson reminders.
# For Gmail, use an App Password (not your account password) and SMTP_SECURE=true with port 465,
# or SMTP_SECURE=false with port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Technical sender. The address MUST be the SMTP_USER (or an address the
# account can send as) for SPF/DMARC. The name becomes the "via <name>"
# suffix on each email; the tutor's name is shown as the From display name
# and their email is set as Reply-To.
EMAIL_FROM="Examify TMS <your-email@gmail.com>"

# Minimum time between "Notify Student" sends for the same lesson, in milliseconds.
# Default is 24 hours (86400000). Prevents accidental spamming / double-sends.
NOTIFY_COOLDOWN_MS=86400000

# Google Calendar / Meet — per-tutor OAuth (tutor connects their own Google account)
# Create an OAuth 2.0 Client ID (Web) in Google Cloud Console and put its values here.
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Where to send the tutor after the OAuth callback completes.
FRONTEND_URL=http://localhost:5173
