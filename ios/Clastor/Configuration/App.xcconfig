// Shared public build settings. Firebase plists and Local.xcconfig stay local.
INFOPLIST_FILE = Configuration/App-Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
OTHER_LDFLAGS = $(inherited) -ObjC
FIREBASE_PLIST_PATH = $(PROJECT_DIR)/Configuration/Firebase/$(APP_ENV)/GoogleService-Info.plist
